{
    "name": "aps-conecta/auditoria",
    "description": "Registra en el registro de auditoría de Nextcloud cada escritura que el usuario confirma a la IA de la suite",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "nextcloud/ocp": "^34.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Auditoria\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Auditoria\\Tests\\Unit\\": "tests/unit/",
            "OCA\\Auditoria\\Tests\\Integration\\": "tests/integration/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
